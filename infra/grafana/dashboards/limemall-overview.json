{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "在线服务数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 7 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(up{job=\"limemall-services\"})", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "总 QPS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"limemall-services\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx 错误率(次/秒)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"limemall-services\",status=~\"5..\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "缓存回源 DB(次/秒)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 3, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(rate(limemall_cache_db_loads[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "布隆过滤器累计拦截",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(limemall_cache_bloom_rejects)", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "JVM 堆使用",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"limemall-services\",area=\"heap\"})", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "各服务 QPS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"limemall-services\"}[1m]))", "legendFormat": "{{application}}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "接口 P95 延迟",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{job=\"limemall-services\"}[1m])))", "legendFormat": "{{application}}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "缓存命中 vs 回源 DB",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(limemall_cache_l1_hits[1m]))", "legendFormat": "L1 命中", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum(rate(limemall_cache_l2_hits[1m]))", "legendFormat": "L2 命中", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "sum(rate(limemall_cache_db_loads[1m]))", "legendFormat": "回源 DB", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "D", "expr": "sum(rate(limemall_cache_bloom_rejects[1m]))", "legendFormat": "布隆拦截", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM 堆内存 / GC 暂停",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{job=\"limemall-services\",area=\"heap\"})", "legendFormat": "{{application}} 堆", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "数据库连接池活跃连接",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (hikaricp_connections_active{job=\"limemall-services\"})", "legendFormat": "{{application}} 活跃", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum by (application) (hikaricp_connections_pending{job=\"limemall-services\"})", "legendFormat": "{{application}} 等待", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "RabbitMQ 监听器消费速率",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(rabbitmq_published_total{job=\"limemall-services\"}[1m]))", "legendFormat": "发送消息/秒", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum(rate(rabbitmq_consumed_total{job=\"limemall-services\"}[1m]))", "legendFormat": "消费消息/秒", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "sum(rabbitmq_connections{job=\"limemall-services\"})", "legendFormat": "MQ 连接数", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [ "limemall", "microservice" ],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LimeMall 服务总览",
  "uid": "limemall-overview",
  "version": 1
}
