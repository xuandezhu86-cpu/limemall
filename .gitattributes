# 统一换行符，避免 Windows/Linux 协作时整个文件 diff
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.conf text eol=lf

# 二进制文件不做换行转换
*.jks binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.woff binary
*.ez binary
*.jar binary
